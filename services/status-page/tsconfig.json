{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "ES2022"],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["worker-configuration.d.ts", "src/**/*.ts"],
	"exclude": ["node_modules"]
}
