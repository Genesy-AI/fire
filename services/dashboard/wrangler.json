{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dashboard",
	"compatibility_date": "2025-12-19",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"vars": {
		"BETTER_AUTH_URL": "https://firedash.enginy.ai",
		"CLIENT_ID": "genesy",
		"SLACK_BOT_SCOPES": "app_mentions:read,channels:history,channels:join,channels:manage,channels:read,chat:write,emoji:read,groups:history,groups:read,pins:write,reactions:write,users:read,users:read.email",
		"VITE_APP_URL": "https://firedash.enginy.ai"
	},
	"services": [
		{
			"binding": "INCIDENTD",
			"service": "incidentd"
		}
	],
	"hyperdrive": [
		{
			"binding": "DB",
			"id": "c96e9f17d90046d59a9e8d49219e080e"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "fire-images"
		}
	],
	"workflows": [
		{
			"name": "rotation-schedule",
			"binding": "ROTATION_WORKFLOW",
			"class_name": "RotationScheduleWorkflow"
		}
	]
}
