{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dashboard",
	"compatibility_date": "2025-12-19",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"vars": {
		"CLIENT_ID": "enginy"
	},
	"services": [
		{
			"binding": "INCIDENTD",
			"service": "incidentd"
		}
	],
	"hyperdrive": [
		{
			"binding": "DB",
			"id": "ab77c35dd8ff4bcd85f01f55b76a9bed"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "fire-images"
		}
	],
	"workflows": [
		{
			"name": "rotation-schedule",
			"binding": "ROTATION_WORKFLOW",
			"class_name": "RotationScheduleWorkflow"
		}
	]
}
