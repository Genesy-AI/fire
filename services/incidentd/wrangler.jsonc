/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "incidentd",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-27",
	"migrations": [
		{
			"new_sqlite_classes": ["Incident"],
			"tag": "v1",
		},
		{
			"new_sqlite_classes": ["SimilarIncidentsAgent"],
			"tag": "v2-similar-provider-agent",
		},
		{
			"new_sqlite_classes": ["GitHubCommitsAgent"],
			"tag": "v3-github-commits-agent",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Incident",
				"name": "INCIDENT",
			},
			{
				"class_name": "SimilarIncidentsAgent",
				"name": "SIMILAR_INCIDENTS_AGENT",
			},
			{
				"class_name": "GitHubCommitsAgent",
				"name": "GITHUB_COMMITS_AGENT",
			},
		],
	},
	"workflows": [
		{
			"name": "incident-workflow",
			"binding": "INCIDENT_WORKFLOW",
			"class_name": "IncidentWorkflow",
		},
		{
			"name": "incident-agent-turn-workflow",
			"binding": "INCIDENT_AGENT_WORKFLOW",
			"class_name": "IncidentAgentTurnWorkflow",
		},
		{
			"name": "incident-prompt-workflow",
			"binding": "INCIDENT_PROMPT_WORKFLOW",
			"class_name": "IncidentPromptWorkflow",
		},
		{
			"name": "incident-analysis-workflow",
			"binding": "INCIDENT_ANALYSIS_WORKFLOW",
			"class_name": "IncidentAnalysisWorkflow",
		},
	],
	"observability": {
		"enabled": false,
		"logs": {
			"enabled": false,
		},
	},
	"compatibility_flags": ["nodejs_compat"],
	"hyperdrive": [
		{
			"binding": "db",
			"id": "c96e9f17d90046d59a9e8d49219e080e",
			"localConnectionString": "postgresql://postgres:postgres@localhost:5432/fire",
		},
	],
	"d1_databases": [
		{
			"binding": "incidents",
			"database_name": "incidents",
			"database_id": "241ded2b-ecba-4263-9bdd-a65e06cd06df",
		},
	],
	"services": [
		{
			"binding": "incidentd",
			"service": "incidentd",
		},
	],
	"r2_buckets": [
		{
			"binding": "INCIDENT_ARCHIVE",
			"bucket_name": "incident-archive",
		},
	],
	"vars": {
		"FRONTEND_URL": "https://firedash.enginy.ai",
		"CLIENT_ID": "genesy",
	},
	"workers_dev": false,
	"preview_urls": false,
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
